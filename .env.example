# Copy this file to .env and fill in your own values:   cp .env.example .env
# .env is in .gitignore, so your secrets never get committed.

# true  = only LOG calls and SMS, never dial anyone (safe default for development)
# false = really place calls through Twilio
DRY_RUN=true

# From https://console.twilio.com (Account Info)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# A Twilio phone number you own, in +country format
TWILIO_FROM_NUMBER=+10000000000

# The hospital desk phone that rings FIRST, then gets connected to the patient
DESK_NUMBER=+910000000000

# The public https address Twilio can reach (for local testing, an ngrok URL),
# with no slash at the end. Twilio calls this server back on it.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Database. Leave empty to use the file mediq/mediq.db (SQLite).
# PostgreSQL later, for example:  postgresql+psycopg://mediq:password@localhost:5432/mediq
DATABASE_URL=

# Signs login tokens. Anyone who knows it can log in as anyone, so keep it secret.
# Make your own (at least 32 characters) with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# How long a login lasts, in minutes
ACCESS_TOKEN_MINUTES=60

# The first admin account, created automatically on first run (only if no admin
# exists yet). After your first login you can remove ADMIN_PASSWORD from .env.
ADMIN_EMAIL=admin@mediq.example
ADMIN_PASSWORD=
ADMIN_NAME=mediQ Admin

# The hospital's time zone: decides which doctors are "on duty now"
HOSPITAL_TIMEZONE=Asia/Kolkata
