# Every setting mediQ reads, with what it does.
#
# ON YOUR MAC:  copy this file to .env and fill in your values:   cp .env.example .env
# ON VERCEL:    add them in Project > Settings > Environment Variables (see DEPLOY.md).
#               The ones marked [Vercel: required] must be set there.
# .env and .env.production are in .gitignore, so your real values never get committed.
# Only .env.example (this file, with NO real secrets) is shared.


# ======================================================================== database

# Where the data lives.
#   Empty (your Mac):  the file mediq/mediq.db (SQLite), nothing to install.
#   Vercel:            the Neon connection string, from Neon's dashboard > Connection string.
#                      Keep ?sslmode=require at the end (encrypted connection). For example:
#                      postgresql://user:password@ep-cool-name-123.aws.neon.tech/neondb?sslmode=require
#   postgres:// and postgresql:// both work (mediQ picks the psycopg2 driver itself).
# [Vercel: required. Adding Neon from Vercel's Storage tab sets it for you.]
DATABASE_URL=


# ======================================================================== logins

# Signs login tokens. Anyone who knows it can log in as anyone, so keep it secret,
# and use a DIFFERENT one on Vercel than on your Mac. At least 32 characters. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If it's missing: on your Mac a temporary key is used (everyone is logged out on restart);
# on Vercel the app refuses to start, because each copy would invent its own key.
# [Vercel: required]
SECRET_KEY=

# How long a login lasts, in minutes.
ACCESS_TOKEN_MINUTES=60

# The first admin account. Created only if there is no admin yet:
#   on your Mac, automatically when the app starts;
#   for Vercel, by scripts/setup_production.py from your laptop (put these in .env.production).
# The password needs at least 8 characters. After the first login you can remove ADMIN_PASSWORD.
ADMIN_EMAIL=admin@mediq.example
ADMIN_PASSWORD=
ADMIN_NAME=mediQ Admin


# ======================================================================== hospital

# The hospital's time zone: decides "today", which doctors are on duty now,
# free booking slots and no-shows. India: Asia/Kolkata.
HOSPITAL_TIMEZONE=Asia/Kolkata

# Which hospital this copy of mediQ is (shown on the site and in the city-wide summary).
MEDIQ_HOSPITAL_ID=HOSP-001
MEDIQ_HOSPITAL_NAME=Demo City Hospital


# ======================================================================== phone calls (Twilio)

# true  = only LOG call-backs and SMS, never dial anyone (safe; the default if missing)
# false = really place calls through Twilio (needs the four settings below)
# [Vercel: set DRY_RUN=true for now]
DRY_RUN=true

# From https://console.twilio.com (Account Info). Only used when DRY_RUN=false.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# A Twilio phone number you own, in +country format
TWILIO_FROM_NUMBER=+10000000000

# The hospital desk phone that rings FIRST, then gets connected to the patient
DESK_NUMBER=+910000000000

# The public https address Twilio calls back, with no slash at the end.
#   Your Mac: an ngrok URL, e.g. https://your-subdomain.ngrok-free.app
#   Vercel:   your site, e.g. https://curable.vercel.app
PUBLIC_BASE_URL=http://localhost:8000


# ======================================================================== start-up (advanced)

# Run migrations + create the first admin + add demo data when the app starts?
# Leave it out: it's "1" on your Mac and "0" on Vercel automatically
# (on Vercel, scripts/setup_production.py does this once instead).
# MEDIQ_STARTUP_TASKS=1

# Add demo departments, wards, ambulances and 30 medicines on start-up (only if empty).
# 1 = yes (default), 0 = start with an empty hospital.
MEDIQ_SEED=1

# VERCEL: set by Vercel itself on every deployment (=1). Never set it yourself.
# TEST_DATABASE_URL: tests only. Point it at an EMPTY PostgreSQL database to run
#   every test on PostgreSQL:  TEST_DATABASE_URL=postgresql://... pytest
